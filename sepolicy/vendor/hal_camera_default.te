# Allow hal_camera_default to read sysfs
allow hal_camera_default sysfs:file r_file_perms;

# Allow hal_camera_default to write to tad socket and connect to tad daemon
allow hal_camera_default tad_socket:sock_file write;
allow hal_camera_default tad:unix_stream_socket connectto;

# Allow hal_camera_default to find and call hal_idd_default
allow hal_camera_default hal_idd_hwservice:hwservice_manager find;
allow hal_camera_default hal_idd_default:binder call;

# Allow hal_camera_default to access sockets in /dev/socket
allow hal_camera_default socket_device:sock_file write;

# Allow hal_camera_default to access sysfs_leds
allow hal_camera_default sysfs_leds:dir r_dir_perms;
allow hal_camera_default sysfs_leds:file rw_file_perms;

# Allow hal_camera_default to write to custom sysfs camera/ToF nodes
allow hal_camera_default sysfs_camera:file rw_file_perms;
